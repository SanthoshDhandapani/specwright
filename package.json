{
  "name": "specwright",
  "version": "0.1.0",
  "private": false,
  "description": "AI-powered E2E test automation — Playwright BDD framework plugin + Electron desktop app + Claude Code agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/specwright/specwright.git"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dist:mac": "pnpm --filter @specwright/desktop dist:mac",
    "dist:win": "pnpm --filter @specwright/desktop dist:win",
    "dist:linux": "pnpm --filter @specwright/desktop dist:linux",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.20.2",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@specwright/mcp": "workspace:*",
    "claude-runner": "^0.5.1"
  },
  "pnpm": {
    "overrides": {
      "jwt-decode>husky": "-",
      "@anthropic-ai/sdk": "^0.105.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "fast-uri@<=3.1.1": "3.1.2",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "tmp@<0.2.7": "0.2.7",
      "esbuild@>=0.17.0 <0.28.1": "0.28.1",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "vite@<=6.4.2": "6.4.3",
      "hono@<4.12.25": "4.12.25"
    },
    "patchedDependencies": {},
    "neverBuiltDependencies": [
      "jwt-decode"
    ]
  }
}
